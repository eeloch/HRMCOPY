# Copy this file to .env (or set these as real environment variables /
# systemd EnvironmentFile entries on the server) and fill in real values.
# Never commit an actual .env file.

# --- Core ---
# Local development only. Omit this (or set to False) anywhere else.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS ---
# The origin(s) the Next.js frontend is served from, comma-separated.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Leave DB_NAME unset to use local SQLite. Set these to move to Postgres.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Biometric bridge ---
# Shared secret the vendor gateway sends as X-Biometric-Bridge-Key.
BIOMETRIC_BRIDGE_SECRET=

# --- Misc ---
DJANGO_LOGIN_THROTTLE_RATE=5/min
DJANGO_LOG_LEVEL=INFO

# Set True once nginx is terminating HTTPS in front of this app (see
# deploy/README.md step 8) - this also switches on Secure session/CSRF
# cookies and HSTS. Leave False until then: on plain HTTP, a Secure cookie
# is silently dropped by the browser, which breaks every form submit
# (including the admin login) with a CSRF error.
DJANGO_SECURE_SSL_REDIRECT=False

# Set True only once nginx has the matching internal-only /protected-media/
# location from deploy/nginx/rotic-hrm.conf, so it streams document bytes
# instead of Django. Leave False otherwise (the default - Django still
# checks permissions and streams the file itself either way).
DOCUMENTS_USE_X_ACCEL_REDIRECT=False
