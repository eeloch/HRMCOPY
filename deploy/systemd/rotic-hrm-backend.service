[Unit]
Description=Rotic HRM - Django/gunicorn
After=network.target postgresql.service

[Service]
User=rotic
Group=rotic
WorkingDirectory=/opt/rotic_hrm
EnvironmentFile=/opt/rotic_hrm/.env
ExecStart=/opt/rotic_hrm/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
